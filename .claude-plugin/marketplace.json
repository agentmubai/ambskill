  "metadata": {
    "description": "面向创业者与内容创作者的中文 AI Skills 工具箱。帮你做出更好用的 skill，把真实业务、内容与行动用 AI 落地。当前：北冥炼分身，庖丁拆写法。",
    "version": "1.2.0"
  },
  "plugins": [
    {
      "name": "amb-beiming",
      "description": "把一位作者的真实语料（课程转写、访谈、作品、短分享）做成一套可溯源的技能工具箱：原子库 + 知识包 + N 个任务技能 + 路由器。也用于给已有工具箱补新料，或把别人的 skill 改造成可溯源的形态。",
      "source": "./skills/amb-beiming",
      "strict": false,
      "version": "1.1.0",
      "author": {
        "name": "agentmubai",
        "url": "https://github.com/agentmubai"
      },
